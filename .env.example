MONGO_URI=mongodb://localhost:27017/airlux
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
PORT=5000
NODE_ENV=development

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

PURCHASE_APPROVAL_MODE=manager-first

# Optional local-only seed credentials. Never commit real values.
SEED_INVENTORY_EMAIL=
SEED_INVENTORY_PASSWORD=
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
