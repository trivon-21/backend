NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=airlux_demo_local
# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
FRONTEND_URL=http://localhost:4200
DEMO_MODE=true
BACKGROUND_JOBS_ENABLED=false
MAIL_MODE=log
BUSINESS_TIMEZONE=Asia/Colombo
