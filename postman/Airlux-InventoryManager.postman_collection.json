          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/asset-loans", "host": ["{{baseUrl}}"], "path": ["inventory", "asset-loans"] }
          }
        },
        {
          "name": "TC-23 POST return tool (deletes loan, writes log)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-23: 200 + returned loan echoed back', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get('loanId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/inventory/asset-loans/return/{{loanId}}", "host": ["{{baseUrl}}"], "path": ["inventory", "asset-loans", "return", "{{loanId}}"] }
          }
        },
        {
          "name": "TC-24 GET return logs contains the return",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-24: 200 + PMTEST-TAG-01 in logs (NOTE: logs auto-delete after 14 days — TTL index)', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var tags = pm.response.json().map(function (r) { return r.assetTag; });",
                  "  pm.expect(tags).to.include('PMTEST-TAG-01');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/asset-return-logs", "host": ["{{baseUrl}}"], "path": ["inventory", "asset-return-logs"] }
          }
        },
        {
          "name": "TC-25 POST return same loan again -> 500",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-25: 500 Failed to return tool (loan already deleted)', function () {",
                  "  pm.response.to.have.status(500);",
                  "  pm.expect(pm.response.json().message).to.include('Failed to return tool');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/inventory/asset-loans/return/{{loanId}}", "host": ["{{baseUrl}}"], "path": ["inventory", "asset-loans", "return", "{{loanId}}"] }
          }
        }
      ]
    },
    {
      "name": "06 Purchase Order Requests",
      "item": [
        {
          "name": "TC-26 POST create order request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-26: 201 + ORD- id + totalEstimate auto-computed (2x1200 + 5x300 = 3900)', function () {",
                  "  pm.response.to.have.status(201);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.requestId).to.match(/^ORD-/);",
                  "  pm.expect(j.totalEstimate).to.eql(3900);",
                  "  pm.expect(j.status).to.eql('pending-approval');",
                  "  pm.collectionVariables.set('orderRequestId', j.requestId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
