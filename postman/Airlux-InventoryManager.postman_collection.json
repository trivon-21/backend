{
  "info": {
    "name": "Airlux — Inventory Manager API Tests",
    "description": "Full test suite for the /api/inventory module (31 endpoints). Run top-to-bottom with the Collection Runner — requests chain via collection variables (token, itemId, loanId, orderRequestId, rmaId, quarantineId). All test data is prefixed 'PMTEST-' so it is easy to find and clean up. WARNING: POST/PATCH requests write real documents to whatever database the backend's .env points at.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "testSku", "value": "" },
    { "key": "itemId", "value": "" },
    { "key": "supplierName", "value": "" },
    { "key": "loanId", "value": "" },
    { "key": "orderRequestId", "value": "" },
    { "key": "rejectRequestId", "value": "" },
    { "key": "rmaId", "value": "" },
    { "key": "quarantineId", "value": "" },
    { "key": "dispatchOrderId", "value": "" },
    { "key": "materialRequestId", "value": "" },
    { "key": "stockBefore", "value": "" }
  ],
  "item": [
    {
      "name": "00 Setup & Auth",
      "item": [
        {
          "name": "TC-01 Login (gets token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-01: 200 + token + user role returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(j.user).to.be.an('object');",
                  "  pm.collectionVariables.set('token', j.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"testuser@airlux.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "TC-02 No token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-02: 401 Not authenticated', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().message).to.include('Not authenticated');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/list", "host": ["{{baseUrl}}"], "path": ["inventory", "list"] }
          }
        },
        {
          "name": "TC-03 Garbage token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-03: 401 invalid token', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().message).to.include('Invalid or expired');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "not-a-real-token", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/list", "host": ["{{baseUrl}}"], "path": ["inventory", "list"] }
          }
        }
      ]
    },
    {
      "name": "01 Dashboard & Activity",
      "item": [
        {
          "name": "TC-04 GET dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-04: 200 + all 4 stat tiles + arrays', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.stats).to.have.keys(['materialReservations','dispatchQueue','assetHealth','stockAlerts']);",
                  "  pm.expect(j.recentActivity).to.be.an('array');",
                  "  pm.expect(j.reorderList).to.be.an('array');",
                  "  pm.expect(j.status).to.eql('Operational');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/dashboard", "host": ["{{baseUrl}}"], "path": ["inventory", "dashboard"] }
          }
        },
        {
          "name": "TC-05 GET activity log",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-05: 200 + array of typed events', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j).to.be.an('array');",
                  "  if (j.length) pm.expect(['return','dispatch','request','grn','alert']).to.include(j[0].type);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/activity", "host": ["{{baseUrl}}"], "path": ["inventory", "activity"] }
          }
        }
      ]
    },
    {
      "name": "02 Inventory Items",
      "item": [
        {
          "name": "TC-06 POST create item (+auto GRN)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('testSku', 'PMTEST-' + Date.now());"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-06: 201 + status auto-computed normal + id saved', function () {",
                  "  pm.response.to.have.status(201);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.sku).to.eql(pm.collectionVariables.get('testSku'));",
                  "  pm.expect(j.status).to.eql('normal');",
                  "  pm.collectionVariables.set('itemId', j._id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PMTEST Copper Pipe 15mm\",\n  \"sku\": \"{{testSku}}\",\n  \"category\": \"Plumbing\",\n  \"brand\": \"TestBrand\",\n  \"available\": 25,\n  \"reorderLevel\": 10,\n  \"unit\": \"units\",\n  \"unitCost\": 1200,\n  \"location\": \"Warehouse A\",\n  \"supplierName\": \"PMTEST Supplier Co\",\n  \"invoiceNumber\": \"PMTEST-INV-001\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/inventory/item", "host": ["{{baseUrl}}"], "path": ["inventory", "item"] }
          }
        },
        {
          "name": "TC-07 POST duplicate SKU -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-07: 400 SKU already exists', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().message).to.include('SKU already exists');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PMTEST Duplicate\",\n  \"sku\": \"{{testSku}}\",\n  \"category\": \"Plumbing\",\n  \"brand\": \"TestBrand\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/inventory/item", "host": ["{{baseUrl}}"], "path": ["inventory", "item"] }
          }
        },
        {
          "name": "TC-08 GET list contains new item",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-08: 200 + array + created SKU present', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var skus = pm.response.json().map(function (i) { return i.sku; });",
                  "  pm.expect(skus).to.include(pm.collectionVariables.get('testSku'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/list", "host": ["{{baseUrl}}"], "path": ["inventory", "list"] }
          }
        },
        {
          "name": "TC-09 GET single item by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-09: 200 + correct item', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get('itemId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/item/{{itemId}}", "host": ["{{baseUrl}}"], "path": ["inventory", "item", "{{itemId}}"] }
          }
        },
        {
          "name": "TC-10 GET unknown id -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-10: 404 Item not found', function () {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().message).to.include('Item not found');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/item/64b000000000000000000000", "host": ["{{baseUrl}}"], "path": ["inventory", "item", "64b000000000000000000000"] }
          }
        },
        {
          "name": "TC-11 PUT update item",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-11: 200 + unitCost updated to 1500', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().unitCost).to.eql(1500);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"unitCost\": 1500,\n  \"location\": \"Warehouse B\"\n}" },
            "url": { "raw": "{{baseUrl}}/inventory/item/{{itemId}}", "host": ["{{baseUrl}}"], "path": ["inventory", "item", "{{itemId}}"] }
          }
        }
      ]
    },
    {
      "name": "03 Suppliers & Procurement",
      "item": [
        {
          "name": "TC-12 POST create supplier",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('supplierName', 'PMTEST-Supplier-' + Date.now());"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-12: 201 + supplier created active', function () {",
                  "  pm.response.to.have.status(201);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.name).to.eql(pm.collectionVariables.get('supplierName'));",
                  "  pm.expect(j.status).to.eql('active');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{supplierName}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/inventory/suppliers", "host": ["{{baseUrl}}"], "path": ["inventory", "suppliers"] }
          }
        },
        {
          "name": "TC-13 POST duplicate supplier -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-13: 400 Supplier already exists', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().message).to.include('Supplier already exists');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{supplierName}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/inventory/suppliers", "host": ["{{baseUrl}}"], "path": ["inventory", "suppliers"] }
          }
        },
        {
          "name": "TC-14 GET suppliers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-14: 200 + created supplier listed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var names = pm.response.json().map(function (s) { return s.name; });",
                  "  pm.expect(names).to.include(pm.collectionVariables.get('supplierName'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/suppliers", "host": ["{{baseUrl}}"], "path": ["inventory", "suppliers"] }
          }
        },
        {
          "name": "TC-15 GET procurements (auto-GRN from TC-06)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-15: 200 + GRN created by item creation', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var invoices = pm.response.json().map(function (p) { return p.invoiceNumber; });",
                  "  pm.expect(invoices).to.include('PMTEST-INV-001');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/procurements", "host": ["{{baseUrl}}"], "path": ["inventory", "procurements"] }
          }
        }
      ]
    },
    {
      "name": "04 Dispatch Orders & Material Requests",
      "item": [
        {
          "name": "TC-16 GET orders (saves an orderId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-16: 200 + array', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j).to.be.an('array');",
                  "  if (j.length) pm.collectionVariables.set('dispatchOrderId', j[0].orderId);",
                  "  else console.log('No orders in DB — TC-17 will be a no-op (returns null).');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/orders", "host": ["{{baseUrl}}"], "path": ["inventory", "orders"] }
          }
        },
        {
          "name": "TC-17 PATCH order status (by orderId, data-dependent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-17: 200 (KNOWN QUIRK: body is null if orderId not found — no 404)', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var j = pm.response.json();",
                  "  if (j) pm.expect(j.status).to.eql('ready');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ready\",\n  \"lastMovedAt\": \"{{$isoTimestamp}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/inventory/orders/{{dispatchOrderId}}", "host": ["{{baseUrl}}"], "path": ["inventory", "orders", "{{dispatchOrderId}}"] }
          }
        },
        {
          "name": "TC-18 GET material requests (saves a requestId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-18: 200 + array', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j).to.be.an('array');",
                  "  if (j.length) pm.collectionVariables.set('materialRequestId', j[0].requestId);",
                  "  else console.log('No material requests in DB — TC-19 will be a no-op (returns null).');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/material-requests", "host": ["{{baseUrl}}"], "path": ["inventory", "material-requests"] }
          }
        },
        {
          "name": "TC-19 PATCH material request (by requestId, data-dependent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-19: 200 (null body if requestId not found — known quirk)', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var j = pm.response.json();",
                  "  if (j) pm.expect(j.status).to.eql('reserved');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"reserved\",\n  \"lastMovedAt\": \"{{$isoTimestamp}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/inventory/material-requests/{{materialRequestId}}", "host": ["{{baseUrl}}"], "path": ["inventory", "material-requests", "{{materialRequestId}}"] }
          }
        }
      ]
    },
    {
      "name": "05 Asset Management (tool lending)",
      "item": [
        {
          "name": "TC-20 GET technicians (external Dassana DB)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-20: 200 + array (may be empty — reads separate Dassana DB)', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/technicians", "host": ["{{baseUrl}}"], "path": ["inventory", "technicians"] }
          }
        },
        {
          "name": "TC-21 POST check out tool",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var due = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set('dueDate', due.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-21: 201 + loan created, id saved', function () {",
                  "  pm.response.to.have.status(201);",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.assetTag).to.eql('PMTEST-TAG-01');",
                  "  pm.collectionVariables.set('loanId', j._id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toolId\": \"{{itemId}}\",\n  \"toolName\": \"PMTEST Copper Pipe 15mm\",\n  \"assetTag\": \"PMTEST-TAG-01\",\n  \"technicianId\": \"PMTEST-TECH-1\",\n  \"technicianName\": \"PMTEST Technician\",\n  \"dueDate\": \"{{dueDate}}\"\n}"
