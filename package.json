{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node seeds/seedDatabase.js",
    "seed:config": "node seeds/system-config-seed.js",
    "test": "npm run test:legacy && npm run test:domain",
    "test:legacy": "mocha tests/unit/*.test.js",
    "test:domain": "node --test test/*.test.js",
    "workflow:reset-materials": "node scripts/reset-material-workflow.js",
    "workflow:migrate-purchasing": "node scripts/migrate-purchasing-workflow.js",
    "workflow:migrate-orders": "node scripts/migrate-order-compatibility.js",
    "workflow:reconcile-indexes": "node scripts/reconcile-manager-inventory-indexes.js",
    "schema:snapshot": "node scripts/export-schema-snapshot.js",
    "schema:audit": "npm run schema:snapshot && node scripts/audit-schema-snapshot.js --schema-report ../schema-report-new.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "AirLux Catalog API Backend",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "date-holidays": "^3.35.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.8.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-schedule": "^2.1.1",
    "nodemailer": "^8.0.10",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "mocha": "^10.2.0",
    "nodemon": "^3.1.11"
  }
}
